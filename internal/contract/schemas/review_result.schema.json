{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["verdict", "coverage", "finding_dispositions", "summary"],
  "properties": {
    "verdict": {"type": "string", "enum": ["approve", "revise", "blocked"]},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_ids_checked", "paths_reviewed", "off_target_dispositions"],
      "properties": {
        "criterion_ids_checked": {"$ref": "common.schema.json#/$defs/criterion_ids"},
        "paths_reviewed": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}, "uniqueItems": true},
        "off_target_dispositions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "disposition", "reason"],
            "properties": {
              "path": {"$ref": "common.schema.json#/$defs/nonempty"},
              "disposition": {"type": "string", "enum": ["accept", "reject"]},
              "reason": {"$ref": "common.schema.json#/$defs/nonempty"}
            }
          }
        }
      }
    },
    "finding_dispositions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "state"],
        "properties": {
          "finding_id": {"$ref": "common.schema.json#/$defs/id_F"},
          "state": {"type": "string", "enum": ["open", "fixed", "withdrawn"]}
        }
      }
    },
    "summary": {"$ref": "common.schema.json#/$defs/nonempty"}
  }
}
