{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "check_evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "key", "argv", "cwd", "tool_version", "env_names", "started_at", "finished_at", "exit_code", "stdout_ref", "stdout_sha256", "stderr_ref", "stderr_sha256", "assertions", "sources_unchanged", "status"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_digest", "candidate_commit", "candidate_tree", "contract_digest", "check_id", "check_spec_digest", "environment_digest"],
      "properties": {
        "plan_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "candidate_commit": {"$ref": "common.schema.json#/$defs/sha"},
        "candidate_tree": {"$ref": "common.schema.json#/$defs/sha"},
        "contract_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "check_id": {"$ref": "common.schema.json#/$defs/nonempty"},
        "check_spec_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "environment_digest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "argv": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}, "minItems": 1},
    "cwd": {"$ref": "common.schema.json#/$defs/nonempty"},
    "tool_version": {"type": "string"},
    "env_names": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}, "uniqueItems": true},
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "finished_at": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]},
    "exit_code": {"oneOf": [{"type": "null"}, {"type": "integer"}]},
    "stdout_ref": {"$ref": "common.schema.json#/$defs/nonempty"},
    "stdout_sha256": {"$ref": "common.schema.json#/$defs/digest"},
    "stderr_ref": {"$ref": "common.schema.json#/$defs/nonempty"},
    "stderr_sha256": {"$ref": "common.schema.json#/$defs/digest"},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"$ref": "common.schema.json#/$defs/nonempty"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    },
    "sources_unchanged": {"type": "boolean"},
    "status": {"type": "string", "enum": ["passed", "failed", "unknown", "invalidated"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"sources_unchanged": {"const": true}, "exit_code": {"type": "integer"}, "finished_at": {"type": "string"}, "assertions": {"items": {"properties": {"passed": {"const": true}}}}}}}
  ]
}
