{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_record.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "parent_candidate_id", "step_ids", "actual_changed_paths", "off_target_changes", "hard_policy_violations", "created_at"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "candidate_id": {"$ref": "common.schema.json#/$defs/candidate_id"},
    "parent_candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/candidate_id"}]},
    "step_ids": {"$ref": "common.schema.json#/$defs/step_ids"},
    "actual_changed_paths": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}, "uniqueItems": true},
    "off_target_changes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "reason_claimed", "disposition"],
        "properties": {
          "path": {"$ref": "common.schema.json#/$defs/nonempty"},
          "reason_claimed": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/nonempty"}]},
          "disposition": {"type": "string", "enum": ["pending", "accepted", "rejected"]}
        }
      }
    },
    "hard_policy_violations": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonempty"}},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
