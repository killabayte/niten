{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executor_turn.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["candidate", "responses", "questions"],
  "properties": {
    "candidate": {"$ref": "candidate_ready.schema.json"},
    "responses": {"type": "array", "items": {"$ref": "response.schema.json"}},
    "questions": {"type": "array", "items": {"$ref": "question.schema.json"}}
  }
}
