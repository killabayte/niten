{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "disabled": false,
      "allowWrite": ["{{EXECUTOR_SCRATCH}}"],
      "denyWrite": [
        "{{ORIGINAL_REPO}}", "{{STORE}}", "{{GITDIR}}", "{{CONTEXT_COPY}}",
        "{{SOURCE}}/.git", "{{SOURCE}}/.claude", "{{SOURCE}}/.codex",
        "{{SOURCE}}/.agents", "{{SOURCE}}/.mcp.json", "{{CLAUDE_HOME}}", "{{CODEX_HOME}}"
      ],
      "denyRead": ["{{STORE}}", "{{CLAUDE_HOME}}", "{{CODEX_HOME}}"]
    },
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": false,
      "allowAllUnixSockets": false,
      "allowUnixSockets": []
    }
  },
  "permissions": {
    "deny": [
      "Agent", "WebFetch", "WebSearch",
      "Edit(/{{ORIGINAL_REPO}}/**)", "Write(/{{ORIGINAL_REPO}}/**)",
      "Edit(/{{STORE}}/**)", "Write(/{{STORE}}/**)",
      "Edit(/{{GITDIR}}/**)", "Write(/{{GITDIR}}/**)",
      "Edit(/{{CONTEXT_COPY}}/**)", "Write(/{{CONTEXT_COPY}}/**)",
      "Read(/{{CLAUDE_HOME}}/**)", "Read(/{{CODEX_HOME}}/**)"
    ]
  }
}
